# League id from the URL of the league table on fantasy.premierleague.com
# e.g. https://fantasy.premierleague.com/leagues/XXXXX/standings/c
LEAGUE_ID=

# WhatsApp group invite code, i.e. the part after https://chat.whatsapp.com/
# in the group's invite link
WHATSAPP_GROUP_INVITE_CODE=

# Optional: Google Gemini API key for an AI-generated one-line recap of the gameweek,
# prepended to the leaderboard message. If unset, or if the API call fails for any
# reason, the plain leaderboard is sent on its own — this feature is fully optional.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
